@model WebApplication4.Models.product

@{
    ViewData["Title"] = "Delete Product";
}

<style>
    .delete-container {
        max-width: 650px;
        margin: 40px auto;
        padding: 30px;
        background: #fff;
        border: 1px solid #f5c2c7;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
    }

    .detail-row {
        padding: 10px 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .detail-label {
        font-weight: bold;
        width: 150px;
        display: inline-block;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 30px;
    }

    .btn-delete {
        background: #dc3545;
        color: white;
        border: none;
        padding: 12px 22px;
        border-radius: 5px;
        cursor: pointer;
    }

    .btn-back {
        background: #eee;
        color: #222;
        padding: 12px 22px;
        border-radius: 5px;
        text-decoration: none;
    }
</style>

<div class="delete-container">
    <h2 class="text-danger">Delete Product</h2>
    <p class="text-muted mb-4">Are you sure you want to delete this product?</p>

    <div class="detail-row">
        <span class="detail-label">Product ID:</span>
        <span>@Model.id</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Product Name:</span>
        <span>@Model.Name</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Price:</span>
        <span>@Model.Price EGP</span>
    </div>

    <form asp-controller="product" asp-action="Delete" method="post">
        <input type="hidden" asp-for="id" />
        <div class="form-actions">
            <button type="submit" class="btn-delete">Confirm Delete</button>
            <a asp-controller="product" asp-action="Index" class="btn-back">Cancel</a>
        </div>
    </form>
</div>