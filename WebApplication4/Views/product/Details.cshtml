@model WebApplication4.Models.product

@{
    ViewData["Title"] = "Product Details";
}

<style>
    .details-container {
        max-width: 650px;
        margin: 40px auto;
        padding: 30px;
        background: #fff;
        border: 1px solid #eee;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
    }

    .detail-row {
        padding: 12px 0;
        border-bottom: 1px solid #f0f0f0;
        font-size: 16px;
    }

    .detail-label {
        font-weight: bold;
        width: 150px;
        display: inline-block;
        color: #555;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 30px;
    }

    .btn-edit {
        background: #0d6efd;
        color: #fff;
        padding: 10px 20px;
        border-radius: 5px;
        text-decoration: none;
    }

    .btn-back {
        background: #eee;
        color: #222;
        padding: 10px 20px;
        border-radius: 5px;
        text-decoration: none;
    }
</style>

<div class="details-container">
    <h2 class="mb-4">Product Details</h2>

    <div class="detail-row">
        <span class="detail-label">Product ID:</span>
        <span>@Model.id</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Product Name:</span>
        <span>@Model.Name</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Price:</span>
        <span>@Model.Price EGP</span>
    </div>

    <div class="form-actions">
        <a asp-controller="product" asp-action="Edit" asp-route-id="@Model.id" class="btn-edit">Edit</a>
        <a asp-controller="product" asp-action="Index" class="btn-back">Back to List</a>
    </div>
</div>
