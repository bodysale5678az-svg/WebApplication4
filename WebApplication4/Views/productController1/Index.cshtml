@model List<WebApplication4.Models.product>

@{
    ViewData["Title"] = "Products";
}

<style>
    body {
        font-family: Arial, sans-serif;
        background: #fff;
        color: #222;
    }

    .container {
        max-width: 950px;
        margin: 40px auto;
        padding: 0 15px;
    }

    h2 {
        font-size: 30px;
        margin-bottom: 25px;
    }

    .products-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 25px;
    }

    .products-table thead {
        background: #111;
        color: white;
    }

    .products-table th {
        padding: 16px;
        text-align: left;
    }

    .products-table td {
        padding: 16px;
        border-bottom: 1px solid #eee;
    }

    .products-table tbody tr:hover {
        background: #f5f5f5;
    }

    .products-table a {
        text-decoration: none;
    }

    .id-link {
        color: #222;
        font-weight: bold;
    }

    .btn {
        display: inline-block;
        padding: 7px 12px;
        color: white;
        border-radius: 4px;
        font-size: 13px;
        margin-right: 5px;
        text-decoration: none;
        border: none;
    }

    .btn-details {
        background: #0d6efd;
    }

    .btn-edit {
        background: #f0ad4e;
        color: #222;
    }

    .btn-delete {
        background: #dc3545;
    }

    .btn-add {
        display: inline-block;
        padding: 12px 22px;
        background: #198754;
        color: white;
        border-radius: 5px;
        text-decoration: none;
        font-size: 15px;
    }

    .btn:hover,
    .btn-add:hover {
        opacity: 0.8;
    }

    @@media (max-width: 600px) {
        .products-table th,
        .products-table td {
            padding: 8px 5px;
            font-size: 13px;
        }

        .btn {
            padding: 5px;
            margin-bottom: 4px;
        }
    }
</style>

<div class="container">

    <h2>Products</h2>

    <table class="products-table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <a asp-controller="productController1"
                           asp-action="Details"
                           asp-route-id="@item.id"
                           class="id-link">
                            @item.id
                        </a>
                    </td>

                    <td>@item.Name</td>

                    <td>@item.Price EGP</td>

                    <td>
                        <a asp-controller="productController1"
                           asp-action="Details"
                           asp-route-id="@item.id"
                           class="btn btn-details">
                            Details
                        </a>

                        <a asp-controller="productController1"
                           asp-action="Edit"
                           asp-route-id="@item.id"
                           class="btn btn-edit">
                            Edit
                        </a>

                        <a asp-controller="productController1"
                           asp-action="Delete"
                           asp-route-id="@item.id"
                           class="btn btn-delete">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-controller="productController1"
       asp-action="Create"
       class="btn-add">
        + Add Product
    </a>
</div>

