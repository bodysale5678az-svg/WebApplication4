
@model WebApplication4.Models.product

@{
    ViewData["Title"] = "Create Product";
}

<style>
    body {
        font-family: Arial, sans-serif;
        background: #fff;
        color: #222;
    }

    .create-container {
        max-width: 650px;
        margin: 40px auto;
        padding: 30px;
        background: #fff;
        border: 1px solid #eee;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
    }

    .create-container h2 {
        font-size: 30px;
        margin-bottom: 10px;
    }

    .subtitle {
        color: #777;
        margin-bottom: 30px;
    }

    .form-group {
        margin-bottom: 22px;
    }

    .form-group label {
        display: block;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .form-control {
        width: 100%;
        box-sizing: border-box;
        padding: 12px;
        border: 1px solid #ccc;
        border-radius: 5px;
        font-size: 15px;
        outline: none;
    }

    .form-control:focus {
        border-color: #198754;
        box-shadow: 0 0 0 3px rgba(25, 135, 84, 0.12);
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 30px;
    }

    .btn-create {
        background: #198754;
        color: white;
        border: none;
        padding: 12px 22px;
        border-radius: 5px;
        font-size: 15px;
        cursor: pointer;
        text-decoration: none;
    }

    .btn-back {
        background: #eee;
        color: #222;
        padding: 12px 22px;
        border-radius: 5px;
        text-decoration: none;
    }

    .btn-create:hover {
        background: #146c43;
    }

    .btn-back:hover {
        background: #ddd;
    }

    .validation {
        color: #dc3545;
        font-size: 13px;
    }

    @@media (max-width: 600px) {
        .create-container {
            margin: 20px 10px;
            padding: 20px;
        }

        .form-actions {
            flex-wrap: wrap;
        }
    }
</style>

<div class="create-container">

    <h2>Add Product</h2>

    <p class="subtitle">
        Enter the product details below.
    </p>

    <form asp-controller="productController1"
          asp-action="Create"
          method="post">

        <div asp-validation-summary="ModelOnly"
             class="validation">
        </div>

        <div class="form-group">
            <label asp-for="id">Product ID</label>

            <input asp-for="id"
                   class="form-control"
                   type="number"
                   min="1"
                   required />

            <span asp-validation-for="id"
                  class="validation">
            </span>
        </div>

        <div class="form-group">
            <label asp-for="Name">Product Name</label>

            <input asp-for="Name"
                   class="form-control"
                   placeholder="Enter product name"
                   required />

            <span asp-validation-for="Name"
                  class="validation">
            </span>
        </div>

        <div class="form-group">
            <label asp-for="Price">Product Price (EGP)</label>

            <input asp-for="Price"
                   class="form-control"
                   type="number"
                   step="0.01"
                   min="0"
                   placeholder="Enter product price"
                   required />

            <span asp-validation-for="Price"
                  class="validation">
            </span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-create">
                Create Product
            </button>

            <a asp-controller="productController1"
               asp-action="Index"
               class="btn-back">
                Back to List
            </a>
        </div>

    </form>

</div>
